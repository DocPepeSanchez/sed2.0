# SED 2.0 — Variables de entorno
# P-01 (soberanía de datos): la URL debe apuntar a infraestructura mexicana en producción.

DATABASE_URL=postgresql://sed:sed@localhost:5432/sed

# Sesiones cifradas — generar con: openssl rand -base64 32
SESSION_SECRET=cambiar_en_produccion_minimo_32_caracteres_xx

# Idiomas soportados — P-09 bilingüismo por diseño
DEFAULT_LOCALE=es
SUPPORTED_LOCALES=es,yua

# KMS / cifrado a nivel campo (ADR-10) — clave maestra
FIELD_ENCRYPTION_KEY=cambiar_en_produccion_minimo_32_bytes_base64_xx

# Bus de eventos (Kafka/RabbitMQ) — opcional en desarrollo
EVENT_BUS_URL=

# Observabilidad
LOG_LEVEL=info
NODE_ENV=development
